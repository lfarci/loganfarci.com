{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "url": [
                "http://localhost/",
                "http://localhost/about/",
                "http://localhost/articles/",
                "http://localhost/articles/mcp/"
            ],
            "numberOfRuns": 1,
            "settings": { "onlyCategories": ["accessibility"], "chromeFlags": "--headless --no-sandbox" }
        },
        "assert": { "assertions": { "categories:accessibility": ["error", { "minScore": 1 }] } },
        "upload": { "target": "filesystem", "outputDir": "./lighthouse-reports" }
    }
}
